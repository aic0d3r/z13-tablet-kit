#!/usr/bin/env python3
"""Poll Z13 posture, apply it, and expose a virtual SW_TABLET_MODE switch.

The GZ302 advertises SW_TABLET_MODE over WMI but never emits it. This user daemon
drives the virtual switch and asks dock to apply display/touch side effects
when posture changes and periodically for restart recovery.
"""
import glob
import json
import os
import signal
import subprocess
import time
from pathlib import Path
from evdev import UInput, ecodes

DOCK = (0x0B05, 0x1AC1)   # ASUS dock hub  -> external monitor = desktop
FOLIO = (0x0B05, 0x1A30)  # Z13 keyboard folio = laptop
TOUCHPAD_NAME = "ASUSTeK Computer Inc. GZ302EA-Keyboard Touchpad"
SW = ecodes.SW_TABLET_MODE
POLL = 2
APPLY_INTERVAL = 30
RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
SETTINGS_FILE = Path(RUNTIME_DIR) / "z13ctl-plus/tablet-settings.json"
# dock ships next to this script (~/.local/bin or /usr/lib/z13-tablet-kit).
DOCK = Path(__file__).resolve().parent / "dock"
Z13CTL_PLUS = Path.home() / ".local/bin/z13ctl-plus"
if not Z13CTL_PLUS.exists():
    Z13CTL_PLUS = "z13ctl-plus"


def usb(vid, pid):
    for d in glob.glob("/sys/bus/usb/devices/*-*"):
        try:
            if (open(f"{d}/idVendor").read().strip() == "%04x" % vid
                    and open(f"{d}/idProduct").read().strip() == "%04x" % pid):
                return True
        except OSError:
            pass
    return False


def ext_display_present():
    """Any non-eDP DRM connector connected (generic USB-C/HDMI dock fallback)."""
    for d in glob.glob("/sys/class/drm/card*-*"):
        name = d.rsplit("/", 1)[-1]
        if "eDP" in name or "DSI" in name:
            continue
        try:
            if open(f"{d}/status").read().strip() == "connected":
                return True
        except OSError:
            pass
    return False


def detected_posture():
    folio_present = usb(*FOLIO)
    if usb(*DOCK) or ext_display_present():
        return "desktop", folio_present
    if folio_present:
        return "laptop", True
    return "tablet", False


def tablet_settings():
    # Only what this daemon applies; z13-touch-scroll reads scroll settings live.
    try:
        with SETTINGS_FILE.open() as stream:
            loaded = json.load(stream)
    except (OSError, ValueError):
        loaded = {}
    if not isinstance(loaded, dict):
        loaded = {}
    return (loaded.get("disable_touchscreen_in_desktop") is not False,
            loaded.get("touchpad_enabled") is True)


def apply_touchpad(enabled, folio_present):
    if not folio_present:
        return True, False, ""
    for device in glob.glob("/sys/class/input/event*/device"):
        try:
            if Path(device, "name").read_text().strip() != TOUCHPAD_NAME:
                continue
            wanted = "0" if enabled else "1"
            inhibited = Path(device, "inhibited")
            if inhibited.read_text().strip() != wanted:
                inhibited.write_text(wanted)
            return True, enabled, ""
        except OSError as error:
            return False, False, f"touchpad update failed: {error}"
    return False, False, "touchpad input unavailable"


def report_integration(state, folio_present, healthy, error,
                       touchscreen_enabled, touch_scroll_enabled,
                       touchpad_enabled):
    def boolean(value):
        return str(value).lower()

    try:
        result = subprocess.run([
            Z13CTL_PLUS, "tablet", "report",
            f"--posture={state}",
            f"--folio-present={boolean(folio_present)}",
            f"--healthy={boolean(healthy)}",
            f"--error={error}",
            f"--last-seen={int(time.time())}",
            f"--touchscreen-enabled={boolean(touchscreen_enabled)}",
            f"--touch-scroll-enabled={boolean(touch_scroll_enabled)}",
            f"--touchpad-enabled={boolean(touchpad_enabled)}",
        ], capture_output=True, text=True)
    except OSError as exc:  # z13ctl-plus missing: report and keep polling
        print(f"tablet integration report failed: {exc}", flush=True)
        return False
    if result.returncode != 0:
        print(result.stderr.strip() or "tablet integration report failed", flush=True)
        return False
    return True


def apply_posture(state, folio_present, settings):
    disable_touch_in_desktop, touchpad_setting = settings
    touchscreen_enabled = not (
        state == "desktop" and disable_touch_in_desktop)
    touchpad_enabled = False
    try:
        result = subprocess.run([
            DOCK, state,
            str(disable_touch_in_desktop).lower(),
        ], capture_output=True, text=True)
        if result.stdout:
            print(result.stdout.strip(), flush=True)
        error = "" if result.returncode == 0 else (
            result.stderr.strip() or "posture application failed")
    except OSError as exc:  # dock missing: retry on the next poll
        error = f"posture application failed: {exc}"
    if not error:
        # apply_touchpad returns a non-empty error exactly when it fails.
        _, touchpad_enabled, error = apply_touchpad(
            touchpad_setting, folio_present)
    if error:
        print(error, flush=True)
    # The report only feeds the GUI health chip and is resent on the 30 s reapply;
    # its failure must not block the tablet-mode switch.
    report_integration(
        state, folio_present, not error, error, touchscreen_enabled,
        touchscreen_enabled, touchpad_enabled)
    return not error


def main():
    ui = UInput(events={ecodes.EV_SW: [SW]}, name="z13-tablet-switch")
    stopping = False

    def stop(_signum, _frame):
        nonlocal stopping
        stopping = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    switch_state = None
    applied_posture = None
    applied_folio = None
    applied_settings = None
    last_apply = 0.0
    while not stopping:
        state, folio_present = detected_posture()
        settings = tablet_settings()
        now = time.monotonic()
        if (state != applied_posture or folio_present != applied_folio
                or settings != applied_settings
                or now - last_apply >= APPLY_INTERVAL):
            if apply_posture(state, folio_present, settings):
                applied_posture = state
                applied_folio = folio_present
                applied_settings = settings
                last_apply = now
        # Follow detected posture, not apply success: a failed touch or
        # z13ctl-plus update must not disable posture-gated auto-rotate.
        want = int(state == "tablet")
        if want != switch_state:
            ui.write(ecodes.EV_SW, SW, want)
            ui.syn()
            switch_state = want
        time.sleep(POLL)
    ui.write(ecodes.EV_SW, SW, 0)
    ui.syn()
    ui.close()


if __name__ == "__main__":
    main()
