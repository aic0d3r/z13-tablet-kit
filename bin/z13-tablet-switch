#!/usr/bin/env python3
"""Poll Z13 posture, apply it, and expose a virtual SW_TABLET_MODE switch.

The GZ302 advertises SW_TABLET_MODE over WMI but never emits it. This user daemon
drives the virtual switch and asks dock to apply display/touch side effects
when posture changes and periodically for restart recovery.
"""
import glob
import signal
import subprocess
import time
from pathlib import Path
from evdev import UInput, ecodes

DOCK = (0x0B05, 0x1AC1)   # ASUS dock hub  -> external monitor = desktop
FOLIO = (0x0B05, 0x1A30)  # Z13 keyboard folio = laptop
SW = ecodes.SW_TABLET_MODE
POLL = 2
APPLY_INTERVAL = 30


def usb(vid, pid):
    for d in glob.glob("/sys/bus/usb/devices/*-*"):
        try:
            v = open(f"{d}/idVendor").read().strip()
            p = open(f"{d}/idProduct").read().strip()
            if v == "%04x" % vid and p == "%04x" % pid:
                return True
        except OSError:
            pass
    return False


def ext_display_present():
    """Any non-eDP DRM connector connected (generic USB-C/HDMI dock fallback)."""
    for d in glob.glob("/sys/class/drm/card*-*"):
        name = d.rsplit("/", 1)[-1]
        if "eDP" in name or "DSI" in name:
            continue
        try:
            if open(f"{d}/status").read().strip() == "connected":
                return True
        except OSError:
            pass
    return False


def posture():
    if usb(*DOCK) or ext_display_present():
        return "desktop"
    if usb(*FOLIO):
        return "laptop"
    return "tablet"


def main():
    ui = UInput(events={ecodes.EV_SW: [SW]}, name="z13-tablet-switch")
    stopping = False

    def stop(_signum, _frame):
        nonlocal stopping
        stopping = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    switch_state = None
    applied_posture = None
    last_apply = 0.0
    while not stopping:
        state = posture()
        now = time.monotonic()
        if state != applied_posture or now - last_apply >= APPLY_INTERVAL:
            if subprocess.call([Path.home() / ".local/bin/dock", state]) == 0:
                applied_posture = state
                last_apply = now
        if state == applied_posture:
            want = int(state == "tablet")
            if want != switch_state:
                ui.write(ecodes.EV_SW, SW, want)
                ui.syn()
                switch_state = want
        time.sleep(POLL)
    ui.write(ecodes.EV_SW, SW, 0)
    ui.syn()
    ui.close()


if __name__ == "__main__":
    main()
