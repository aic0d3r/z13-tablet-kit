#!/bin/bash
# Z13 posture manager: desktop / laptop / tablet.
#   desktop = ASUS dock hub present (0b05:1ac1)  -> external monitor
#   laptop  = Z13 keyboard folio present (0b05:1a30)
#   tablet  = neither
# Touch is off only in desktop; on in laptop/tablet.
# Display policy is applied by the z13ctl daemon.
# Runs in the user session: udev rule (drm + ASUS usb add/remove) + login autostart
# + a slow safety timer.
set -u
runtime_uid=$(id -u)
export XDG_RUNTIME_DIR=/run/user/"$runtime_uid" DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/"$runtime_uid"/bus
DEST=org.kde.KWin; IF=org.kde.KWin.InputDevice
LOG="$HOME/asus-dock.log"
RUNDIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/z13-tablet-kit"
STATEF="$RUNDIR/posture"
CACHE="$HOME/.cache/asus-dock-touch.path"
NAME="ELAN9008:00 04F3:43C7"
Z13CTL="$HOME/.local/bin/z13ctl"
if [ ! -x "$Z13CTL" ]; then Z13CTL=$(command -v z13ctl 2>/dev/null || true); fi

usb_present() {	# vid pid
	for d in /sys/bus/usb/devices/*-*; do
		[ -r "$d/idVendor" ] || continue
		[ "$(cat "$d/idVendor" 2>/dev/null)" = "$1" ] && [ "$(cat "$d/idProduct" 2>/dev/null)" = "$2" ] && return 0
	done
	return 1
}

# --- 1. posture ---
if   usb_present 0b05 1ac1; then state=desktop
elif usb_present 0b05 1a30; then state=laptop
else state=tablet; fi

mkdir -p "$RUNDIR"
chmod 700 "$RUNDIR"
prev=$(cat "$STATEF" 2>/dev/null)

# Publish on every invocation so the timer naturally retries daemon failures.
publish_ok=true
if [ -z "$Z13CTL" ] || ! "$Z13CTL" display posture "$state"; then
	publish_ok=false
fi

# --- 2. resolve touchscreen KWin object path (cached) ---
ismytouch() {
	local nm; nm=$(gdbus call --session --dest "$DEST" --object-path "$1" \
		--method org.freedesktop.DBus.Properties.Get "$IF" name 2>/dev/null)
	echo "$nm" | grep -q "$NAME" && ! echo "$nm" | grep -qi stylus
}
path=$(cat "$CACHE" 2>/dev/null)
if [ -z "$path" ] || ! ismytouch "$path"; then
	path=""
	for p in $(qdbus6 "$DEST" 2>/dev/null | grep -E 'InputDevice/event'); do
		ismytouch "$p" && { path="$p"; break; }
	done
	mkdir -p "${CACHE%/*}"; echo "$path" > "$CACHE"
fi

# --- 3. enforce profile (idempotent) ---
want=$([ "$state" = desktop ] && echo false || echo true)   # touch off only when docked
if [ -n "$path" ]; then
	cur=$(gdbus call --session --dest "$DEST" --object-path "$path" \
		--method org.freedesktop.DBus.Properties.Get "$IF" enabled 2>/dev/null)
	if { [ "$want" = false ] && [[ "$cur" == *true* ]]; } || { [ "$want" = true ] && [[ "$cur" == *false* ]]; }; then
		gdbus call --session --dest "$DEST" --object-path "$path" \
			--method org.freedesktop.DBus.Properties.Set "$IF" enabled "<$want>" >/dev/null 2>&1
	fi
fi
# --- 4. log the result; a failed publish makes the service retryable ---
if [ "$publish_ok" = true ]; then
	tmp="$STATEF.tmp.$$"
	if ! printf '%s\n' "$state" > "$tmp" || ! mv -f "$tmp" "$STATEF"; then
		rm -f "$tmp"
		echo "$(date '+%F %T') $state pending (posture state write failed, touch=$want)" >> "$LOG"
		exit 1
	fi
	if [ "$state" != "$prev" ]; then
		echo "$(date '+%F %T') $state (touch=$want)" >> "$LOG"
	fi
else
	echo "$(date '+%F %T') $state pending (z13ctl unavailable, touch=$want)" >> "$LOG"
	exit 1
fi
