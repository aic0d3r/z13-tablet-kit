#!/bin/bash
# Apply a desktop / laptop / tablet posture supplied by z13-tablet-switch.
# Touch is off only in desktop; on in laptop/tablet.
# Display policy is applied by the z13ctl-plus daemon.
set -u
DEST=org.kde.KWin; IF=org.kde.KWin.InputDevice
RUNDIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/z13-tablet-kit"
STATEF="$RUNDIR/posture"
NAME="ELAN9008:00 04F3:43C7"
Z13CTL_PLUS="$HOME/.local/bin/z13ctl-plus"
if [ ! -x "$Z13CTL_PLUS" ]; then Z13CTL_PLUS=$(command -v z13ctl-plus 2>/dev/null || true); fi

case "${1-}" in
	desktop|laptop|tablet) state=$1 ;;
	*) echo "usage: dock {desktop|laptop|tablet} [disable-touch-in-desktop]" >&2; exit 2 ;;
esac
case "${2-true}" in
	true|false) disable_touch_in_desktop=${2-true} ;;
	*) echo "dock: disable-touch-in-desktop must be true or false" >&2; exit 2 ;;
esac

mkdir -p "$RUNDIR"
chmod 700 "$RUNDIR"
prev=$(cat "$STATEF" 2>/dev/null || true)

# z13-tablet-switch retries this command until publication succeeds.
publish_ok=true
if [ -z "$Z13CTL_PLUS" ] || ! "$Z13CTL_PLUS" display posture "$state"; then
	publish_ok=false
fi

# Resolve the touchscreen KWin object path.
path=""
for p in $(qdbus6 "$DEST" 2>/dev/null | grep -E 'InputDevice/event'); do
	nm=$(gdbus call --session --dest "$DEST" --object-path "$p" \
		--method org.freedesktop.DBus.Properties.Get "$IF" name 2>/dev/null)
	if echo "$nm" | grep -q "$NAME" && ! echo "$nm" | grep -qi stylus; then
		path=$p
		break
	fi
done

# Enforce the profile idempotently.
want=true
if [ "$state" = desktop ] && [ "$disable_touch_in_desktop" = true ]; then want=false; fi
if [ -z "$path" ]; then
	echo "dock: touchscreen unavailable" >&2
	exit 1
fi
if ! cur=$(gdbus call --session --dest "$DEST" --object-path "$path" \
	--method org.freedesktop.DBus.Properties.Get "$IF" enabled 2>/dev/null); then
	echo "dock: touchscreen state unavailable" >&2
	exit 1
fi
if { [ "$want" = false ] && [[ "$cur" == *true* ]]; } || { [ "$want" = true ] && [[ "$cur" == *false* ]]; }; then
	if ! gdbus call --session --dest "$DEST" --object-path "$path" \
		--method org.freedesktop.DBus.Properties.Set "$IF" enabled "<$want>" >/dev/null 2>&1; then
		echo "dock: touchscreen update failed" >&2
		exit 1
	fi
fi

# Publish state only after z13ctl-plus and KWin accept it.
if [ "$publish_ok" = true ]; then
	tmp="$STATEF.tmp.$$"
	if ! printf '%s\n' "$state" > "$tmp" || ! mv -f "$tmp" "$STATEF"; then
		rm -f "$tmp"
		echo "dock: $state pending (posture state write failed, touch=$want)" >&2
		exit 1
	fi
	echo "dock: $state (touch=$want)"
else
	echo "dock: $state pending (z13ctl-plus unavailable, touch=$want)" >&2
	exit 1
fi

# Gate the on-screen keyboard on posture. KWin's "TouchOnly" mode pops the OSK
# on any touch device regardless of physical keyboards, so it appears even with
# the folio or an external keyboard attached. Force it Off whenever a real
# keyboard is present; restore TouchOnly only in tablet posture.
case "$state" in
	tablet) osk_mode=1 ;;  # TouchOnly
	*)      osk_mode=0 ;;  # Off
esac
dbus-send --session --dest=org.kde.KWin --type=method_call /VirtualKeyboard \
	org.freedesktop.DBus.Properties.Set \
	string:org.kde.kwin.VirtualKeyboard string:mode \
	variant:int32:"$osk_mode" >/dev/null 2>&1

# The on-screen keyboard (plasma-keyboard / maliit-keyboard) caches the output
# geometry and scale at startup. A posture switch changes the active panel and
# its scale, so the keyboard keeps rendering against a stale "placeholder
# screen" and its keys get clipped at the edges. Restarting it lets KWin
# relaunch it against the new output. The display reconfig is asynchronous, so
# wait briefly first; run detached so this command never blocks posture apply.
# Only on a real change: z13-tablet-switch re-runs dock every 30 s for recovery.
# -x matches the process name only, not any command line mentioning it.
if [ "$prev" != "$state" ] && pgrep -u "$(id -u)" -x 'plasma-keyboard|maliit-keyboard' >/dev/null 2>&1; then
	(sleep 2; pkill -u "$(id -u)" -x 'plasma-keyboard|maliit-keyboard') >/dev/null 2>&1 &
fi
