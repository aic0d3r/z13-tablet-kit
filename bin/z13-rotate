#!/bin/bash
# Auto-rotate the Z13 internal panel from the accelerometer — ONLY in tablet posture.
# Reads runtime posture published by asus-dock. When not tablet, requests normal
# rotation. Axis->rotation mapping may need flipping for your unit's
# sensor mount; hold the tablet and use the calibration note at the bottom to tune.
set -u
runtime_uid=$(id -u)
export XDG_RUNTIME_DIR=/run/user/"$runtime_uid" DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/"$runtime_uid"/bus
DEV=/sys/bus/iio/devices/iio:device0
STATEF="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/z13-tablet-kit/posture"
Z13CTL="$HOME/.local/bin/z13ctl"
if [ ! -x "$Z13CTL" ]; then Z13CTL=$(command -v z13ctl 2>/dev/null || true); fi
POLL=2         # seconds between samples
prev=none

abs() { local v="${1:-0}"; [ "$v" -lt 0 ] && echo $((0 - v)) || echo "$v"; }

while :; do
	posture=$(cat "$STATEF" 2>/dev/null)
	if [ "$posture" != tablet ]; then
		# Posture publication also requests laptop/desktop defaults, so only undo a
		# rotation that this process successfully requested.
		if [ "$prev" != none ]; then
			[ -n "$Z13CTL" ] && "$Z13CTL" display rotation none >/dev/null 2>&1 && prev=none
		fi
		sleep "$POLL"; continue
	fi

	read -r x < "$DEV/in_accel_x_raw" 2>/dev/null
	read -r y < "$DEV/in_accel_y_raw" 2>/dev/null
	read -r z < "$DEV/in_accel_z_raw" 2>/dev/null
	x=${x:-0}; y=${y:-0}; z=${z:-0}
	ax=$(abs "$x"); ay=$(abs "$y"); az=$(abs "$z")

	# dominant axis -> rotation. Calibrated from your readings:
	# normal landscape gravity=-y (y<0 -> none, y>0 -> inverted);
	# portrait gravity on x (x<0 -> right, x>0 -> left). z dominant = flat, hold.
	if   [ "$az" -ge "$ax" ] && [ "$az" -ge "$ay" ]; then rot=$prev
	elif [ "$ay" -ge "$ax" ]; then [ "$y" -ge 0 ] && rot=inverted || rot=none
	else [ "$x" -ge 0 ] && rot=left || rot=right
	fi

	if [ -n "$rot" ] && [ "$rot" != "$prev" ]; then
		[ -n "$Z13CTL" ] && "$Z13CTL" display rotation "$rot" >/dev/null 2>&1 && prev=$rot
	fi
	sleep "$POLL"
done
