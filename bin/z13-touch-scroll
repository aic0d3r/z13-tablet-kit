#!/usr/bin/env python3
"""
z13-touch-scroll: 2-finger vertical swipe → mouse wheel scroll.

Reads the ELAN9008 touchscreen and detects 2-finger vertical swipes,
then injects mouse wheel events via evdev UInput. Wheel events work
everywhere: terminal scrollback, opencode TUI, browsers, etc.

No external dependencies beyond python-evdev. Touchscreen read access
is granted by the udev uaccess rule (logind auto-sets ACL). /dev/uinput
write access is auto-granted by logind for the active session.

Tuning: edit STEP / NOTCHES_PER_STEP below.
"""

import json
import os
import sys

import evdev

TOUCHSCREEN_NAME = "ELAN9008:00 04F3:43C7"
MIN_FINGERS = 2
SENSITIVITY_STEPS = {1: 180, 2: 135, 3: 90, 4: 60, 5: 30}
RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
POSTURE_FILE = os.path.join(RUNTIME_DIR, "z13-tablet-kit/posture")
SETTINGS_FILE = os.path.join(RUNTIME_DIR, "z13ctl-plus/tablet-settings.json")


def find_touchscreen():
    """Find the touchscreen device (has ABS_MT_SLOT, not the stylus)."""
    for path in evdev.list_devices():
        try:
            dev = evdev.InputDevice(path)
        except PermissionError:
            continue
        if TOUCHSCREEN_NAME in dev.name and "Stylus" not in dev.name:
            caps = dev.capabilities().get(evdev.ecodes.EV_ABS, [])
            abs_codes = {c for c, _ in caps}
            if evdev.ecodes.ABS_MT_SLOT in abs_codes:
                return dev
    return None


def touch_scroll_settings():
    try:
        with open(POSTURE_FILE) as posture:
            if posture.read().strip() == "desktop":
                return None
    except OSError:
        return None
    sensitivity = 3
    speed = 2
    try:
        with open(SETTINGS_FILE) as stream:
            settings = json.load(stream)
        sensitivity = settings.get("scroll_sensitivity", sensitivity)
        speed = settings.get("scroll_speed", speed)
    except (AttributeError, OSError, ValueError):
        pass
    if not isinstance(sensitivity, int) or not 1 <= sensitivity <= 5:
        sensitivity = 3
    if not isinstance(speed, int) or not 1 <= speed <= 5:
        speed = 2
    return SENSITIVITY_STEPS[sensitivity], speed


def main():
    dev = find_touchscreen()
    if not dev:
        print(f"Touchscreen '{TOUCHSCREEN_NAME}' not found "
              f"(or no read permission — check udev uaccess rule).",
              file=sys.stderr)
        sys.exit(1)

    # Create virtual mouse wheel device
    try:
        ui = evdev.UInput(
            events={evdev.ecodes.EV_REL: [evdev.ecodes.REL_WHEEL]},
            name="z13-touch-wheel")
    except Exception as e:
        print(f"Cannot create UInput device: {e}", file=sys.stderr)
        sys.exit(1)

    print(f"z13-touch-scroll: {dev.name} ({dev.path})", flush=True)
    print(f"  {MIN_FINGERS}-finger swipe → mouse wheel", flush=True)

    pos_y = {}            # slot → current Y
    current_slot = 0
    ref_y = None          # avg-Y when swipe started
    last_trigger = 0      # last triggered delta position
    gesture_enabled = False
    step = SENSITIVITY_STEPS[3]
    notches_per_step = 2

    for event in dev.read_loop():
        if event.type == evdev.ecodes.EV_ABS:
            if event.code == evdev.ecodes.ABS_MT_SLOT:
                current_slot = event.value
            elif event.code == evdev.ecodes.ABS_MT_TRACKING_ID:
                if event.value == -1:
                    pos_y.pop(current_slot, None)
                else:
                    if not pos_y:
                        settings = touch_scroll_settings()
                        gesture_enabled = settings is not None
                        if settings:
                            step, notches_per_step = settings
                    pos_y[current_slot] = None
            elif event.code == evdev.ecodes.ABS_MT_POSITION_Y:
                if current_slot in pos_y:
                    pos_y[current_slot] = event.value

        elif (event.type == evdev.ecodes.EV_SYN
              and event.code == evdev.ecodes.SYN_REPORT):
            active = {k: v for k, v in pos_y.items() if v is not None}

            if gesture_enabled and len(active) >= MIN_FINGERS:
                avg = sum(active.values()) / len(active)
                if ref_y is None:
                    ref_y = avg
                    last_trigger = 0

                delta = avg - ref_y  # positive = fingers moved down

                while delta - last_trigger > step:
                    ui.write(evdev.ecodes.EV_REL, evdev.ecodes.REL_WHEEL,
                             -notches_per_step)  # scroll down
                    ui.syn()
                    last_trigger += step
                while last_trigger - delta > step:
                    ui.write(evdev.ecodes.EV_REL, evdev.ecodes.REL_WHEEL,
                             notches_per_step)  # scroll up
                    ui.syn()
                    last_trigger -= step
            else:
                ref_y = None


if __name__ == "__main__":
    main()
