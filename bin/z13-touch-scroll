#!/usr/bin/env python3
"""
z13-touch-scroll: touchscreen scrolling and context-menu gestures.

Reads the ELAN9008 touchscreen and detects 2-finger vertical swipes,
then injects mouse wheel events via evdev UInput. An optional stationary
two-finger hold (~650 ms) moves the pointer to the touch point and sends a
right-click, giving a context menu where KDE Wayland has no touch right-click.

Sensitivity, speed, and context-menu behavior are controlled through z13ctl-plus.
"""

import json
import os
import select
import subprocess
import sys
import time

import evdev

TOUCHSCREEN_NAME = "ELAN9008:00 04F3:43C7"
MIN_FINGERS = 2
SENSITIVITY_STEPS = {1: 180, 2: 135, 3: 90, 4: 60, 5: 30}
HOLD_SECONDS = 0.65
HOLD_MOVE = 25
# Touchscreen ABS range vs panel physical pixels (GL = logical pixels).
TOUCH_MAX_X = 3408
TOUCH_MAX_Y = 2064
PANEL_W = 2560
PANEL_H = 1600
RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
POSTURE_FILE = os.path.join(RUNTIME_DIR, "z13-tablet-kit/posture")
SETTINGS_FILE = os.path.join(RUNTIME_DIR, "z13ctl-plus/tablet-settings.json")


def find_touchscreen():
    """Find the touchscreen device (has ABS_MT_SLOT, not the stylus)."""
    for path in evdev.list_devices():
        try:
            dev = evdev.InputDevice(path)
        except PermissionError:
            continue
        if TOUCHSCREEN_NAME in dev.name and "Stylus" not in dev.name:
            caps = dev.capabilities().get(evdev.ecodes.EV_ABS, [])
            abs_codes = {c for c, _ in caps}
            if evdev.ecodes.ABS_MT_SLOT in abs_codes:
                return dev
    return None


def touch_action_settings():
    """Return (step_pixels, notches, context_menu_enabled) or None if disabled."""
    posture = ""
    try:
        with open(POSTURE_FILE) as stream:
            posture = stream.read().strip()
    except OSError:
        return None
    sensitivity = 3
    speed = 2
    context_menu = False
    disable_touch_in_desktop = True
    try:
        with open(SETTINGS_FILE) as stream:
            settings = json.load(stream)
        sensitivity = settings.get("scroll_sensitivity", sensitivity)
        speed = settings.get("scroll_speed", speed)
        context_menu = settings.get("two_finger_hold_context_menu") is True
        disable_touch_in_desktop = (
            settings.get("disable_touchscreen_in_desktop") is not False)
    except (AttributeError, OSError, ValueError):
        pass
    if posture == "desktop" and disable_touch_in_desktop:
        return None
    if not isinstance(sensitivity, int) or not 1 <= sensitivity <= 5:
        sensitivity = 3
    if not isinstance(speed, int) or not 1 <= speed <= 5:
        speed = 2
    return SENSITIVITY_STEPS[sensitivity], speed, context_menu


def new_state():
    return {
        "positions": {},       # slot → [X, Y]
        "origins": {},         # slot → (X, Y) at touch-down
        "current_slot": 0,
        "ref_y": None,
        "fingers": 0,
        "last_trigger": 0,
        "step": SENSITIVITY_STEPS[3],
        "notches": 2,
        "gesture_enabled": False,
        "context_menu_enabled": False,
        "hold_armed": False,
        "hold_emitted": False,
        "hold_started": 0.0,
    }


def handle_event(state, event):
    """Process one input event. Return True if a SYN_REPORT was seen."""
    positions = state["positions"]
    slot = state["current_slot"]

    if event.type != evdev.ecodes.EV_ABS:
        return (event.type == evdev.ecodes.EV_SYN
                and event.code == evdev.ecodes.SYN_REPORT)

    if event.code == evdev.ecodes.ABS_MT_SLOT:
        state["current_slot"] = event.value
        return False

    slot = state["current_slot"]

    if event.code == evdev.ecodes.ABS_MT_TRACKING_ID:
        if event.value == -1:
            positions.pop(slot, None)
            state["origins"].pop(slot, None)
            state["hold_armed"] = False
        else:
            if not positions:
                settings = touch_action_settings()
                state["gesture_enabled"] = settings is not None
                if settings:
                    state["step"], state["notches"], \
                        state["context_menu_enabled"] = settings
            positions[slot] = [None, None]
            if len(positions) == 2:
                state["hold_armed"] = (
                    state["gesture_enabled"]
                    and state["context_menu_enabled"])
                state["hold_emitted"] = False
                state["hold_started"] = time.monotonic()
            elif len(positions) > 2:
                state["hold_armed"] = False
        return False

    if slot not in positions:
        return False

    if event.code == evdev.ecodes.ABS_MT_POSITION_X:
        positions[slot][0] = event.value
    elif event.code == evdev.ecodes.ABS_MT_POSITION_Y:
        positions[slot][1] = event.value
    else:
        return False

    # Cancel hold on excessive movement.
    point = positions[slot]
    if None not in point:
        origin = state["origins"].get(slot)
        if origin is None:
            state["origins"][slot] = tuple(point)
        elif (abs(point[0] - origin[0]) > HOLD_MOVE
              or abs(point[1] - origin[1]) > HOLD_MOVE):
            state["hold_armed"] = False

    return False


def emit_scrolls(state, ui):
    active = {
        slot: point[1]
        for slot, point in state["positions"].items()
        if point[1] is not None
    }
    # A finger landing or lifting shifts the average; re-anchor instead of scrolling.
    if len(active) != state["fingers"]:
        state["fingers"] = len(active)
        state["ref_y"] = None
    if not (state["gesture_enabled"] and len(active) >= MIN_FINGERS):
        state["ref_y"] = None
        return
    avg = sum(active.values()) / len(active)
    if state["ref_y"] is None:
        state["ref_y"] = avg
        state["last_trigger"] = 0
    delta = avg - state["ref_y"]
    step = state["step"]
    while delta - state["last_trigger"] > step:
        ui.write(evdev.ecodes.EV_REL, evdev.ecodes.REL_WHEEL,
                 -state["notches"])
        ui.syn()
        state["last_trigger"] += step
    while state["last_trigger"] - delta > step:
        ui.write(evdev.ecodes.EV_REL, evdev.ecodes.REL_WHEEL,
                 state["notches"])
        ui.syn()
        state["last_trigger"] -= step


def check_hold(state, ui):
    if (state["hold_armed"] and not state["hold_emitted"]
            and len(state["positions"]) == 2
            and len(state["origins"]) == 2
            and time.monotonic() - state["hold_started"] >= HOLD_SECONDS):
        emit_context_menu(state, ui)
        state["hold_emitted"] = True


def internal_display():
    """Return (rotation, scale) of the enabled internal panel from KScreen, or None."""
    try:
        result = subprocess.run(["kscreen-doctor", "-j"], capture_output=True,
                                text=True, timeout=2)
        for output in json.loads(result.stdout)["outputs"]:
            if output["name"].startswith("eDP") and output.get("enabled"):
                return output["rotation"], output["scale"]
    except (OSError, ValueError, KeyError, TypeError,
            subprocess.TimeoutExpired):
        pass
    return None


def to_logical(touch_x, touch_y, rotation, scale):
    """Touch ABS -> logical px on the rotated panel.

    KScreen rotation: 1 none, 2 left, 4 inverted, 8 right (same transforms as
    xrandr's touchscreen matrices for left/inverted/right).
    """
    nx, ny = touch_x / TOUCH_MAX_X, touch_y / TOUCH_MAX_Y
    w, h = PANEL_W / scale, PANEL_H / scale
    if rotation == 2:
        return (1 - ny) * h, nx * w
    if rotation == 4:
        return (1 - nx) * w, (1 - ny) * h
    if rotation == 8:
        return ny * h, (1 - nx) * w
    return nx * w, ny * h


def emit_context_menu(state, ui):
    """Move the pointer to the touch centroid and right-click.

    Wayland provides no programmatic context-menu trigger, so we relocate a
    virtual pointer to the touch position and send a real BTN_RIGHT. REL needs
    the current pointer position, which is not exposed; clamping to the
    top-left with a large negative REL first makes the target deterministic.
    """
    xs = [p[0] for p in state["positions"].values() if p[0] is not None]
    ys = [p[1] for p in state["positions"].values() if p[1] is not None]
    if not xs or not ys:
        return
    display = internal_display()
    if display is None:
        # A right-click at a guessed position is worse than none.
        print("hold: skipped, internal display state unavailable",
              file=sys.stderr, flush=True)
        return
    px, py = to_logical(sum(xs) / len(xs), sum(ys) / len(ys), *display)
    # Clamp to top-left, then move to the target, then right-click.
    ui.write(evdev.ecodes.EV_REL, evdev.ecodes.REL_X, -100000)
    ui.write(evdev.ecodes.EV_REL, evdev.ecodes.REL_Y, -100000)
    ui.syn()
    time.sleep(0.05)
    ui.write(evdev.ecodes.EV_REL, evdev.ecodes.REL_X, round(px))
    ui.write(evdev.ecodes.EV_REL, evdev.ecodes.REL_Y, round(py))
    ui.syn()
    time.sleep(0.05)
    ui.write(evdev.ecodes.EV_KEY, evdev.ecodes.BTN_RIGHT, 1)
    ui.syn()
    time.sleep(0.05)
    ui.write(evdev.ecodes.EV_KEY, evdev.ecodes.BTN_RIGHT, 0)
    ui.syn()
    print(f"hold: EMIT right-click @ {px:.0f},{py:.0f}",
          file=sys.stderr, flush=True)


def main():
    dev = find_touchscreen()
    if not dev:
        print(f"Touchscreen '{TOUCHSCREEN_NAME}' not found "
              f"(or no read permission — check udev uaccess rule).",
              file=sys.stderr)
        sys.exit(1)

    try:
        ui = evdev.UInput(
            events={
                evdev.ecodes.EV_REL: [evdev.ecodes.REL_WHEEL,
                                      evdev.ecodes.REL_X, evdev.ecodes.REL_Y],
                evdev.ecodes.EV_KEY: [evdev.ecodes.BTN_LEFT,
                                      evdev.ecodes.BTN_RIGHT],
            },
            name="z13-touch-actions")
    except Exception as e:
        print(f"Cannot create UInput device: {e}", file=sys.stderr)
        sys.exit(1)

    print(f"z13-touch-scroll: {dev.name} ({dev.path})", flush=True)

    state = new_state()
    while True:
        ready, _, _ = select.select([dev.fd], [], [], 0.05)
        if ready:
            for event in dev.read():
                if handle_event(state, event):
                    emit_scrolls(state, ui)
        check_hold(state, ui)


if __name__ == "__main__":
    main()
